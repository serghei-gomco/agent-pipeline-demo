{
  "name": "agent-pipeline-demo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Tiny task list (Node/TS API + React/TS UI) used to demo an AI-agent pipeline with checks.",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "concurrently -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "test": "vitest run",
    "test:tz": "TZ=Europe/Chisinau vitest run && TZ=America/New_York vitest run",
    "lint": "eslint",
    "typecheck": "tsc -p server && tsc -p web",
    "check": "npm run -s typecheck && npm run -s lint -- . && npm run -s test:tz"
  },
  "dependencies": {
    "express": "4.21.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.14.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/express": "4.17.21",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/supertest": "6.0.2",
    "@vitejs/plugin-react": "4.3.3",
    "concurrently": "9.1.0",
    "dotenv": "^18.0.10",
    "eslint": "9.14.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "globals": "15.12.0",
    "jsdom": "25.0.1",
    "supertest": "7.0.0",
    "testdriverai": "^7.11.171",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.13.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
